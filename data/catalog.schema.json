{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cocktail catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bars", "cocktails"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "bars": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "city", "sources"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1 },
          "city": { "type": "string", "minLength": 1 },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "version"],
              "properties": {
                "file": { "type": "string", "minLength": 1 },
                "version": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "cocktails": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "barId", "name", "category", "ingredientTags", "tasteTags", "source"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "barId": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "priceEuro": { "type": "number", "minimum": 0 },
          "ingredientTags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "tasteTags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "page"],
            "properties": {
              "file": { "type": "string", "minLength": 1 },
              "page": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
  }
}
